# Fursynth Backend Environment Variables

# Port for FastAPI server
PORT=8000

# Secret key for JWT auth token signature (Change this to any random string for security)
SECRET_KEY=FURSYNTH_SECRET_KEY_SPACE_COSMIC_2026

# Discord Webhook URL for Instant Order Notifications (Optional)
# Paste your Discord channel webhook URL below to get pinged whenever a client submits an order:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

